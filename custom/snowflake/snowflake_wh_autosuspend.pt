# DEMO POLICY TEMPLATE. DOES NOT PRODUCE REAL RESULTS.
# More info available here: https://github.com/flexera-public/cco_demo
name "Snowflake Adjust Warehouse Auto Suspend [Demo]"
rs_pt_ver 20180301
type "policy"
short_description "Snowflake Adjust Warehouse Auto Suspend [Demo]"
long_description ""
# This is to make it easy to identify this template as a demo template via API
doc_link "https://github.com/flexera-public/cco_demo"
category "Cost"
severity "low"
default_frequency "weekly"
info(
  version: "0.0.1",
  provider: "Snowflake",
  service: "Compute",
  policy_set: "Snowflake",
  recommendation_type: "Usage Reduction",
  hide_skip_approvals: "true",
  demo: "true"
)

###############################################################################
# Parameters
###############################################################################

# This is to make it easy for automation to determine if an applied policy is
# a demo policy or not.
parameter "param_demo" do
  type "string"
  category "Policy Settings"
  label "Demo Policy"
  description "Indicates that this is a demo policy. Should generally be left at its default value."
  allowed_values "True", "False"
  default "True"
end

parameter "param_sf_recommendation" do
  type "string"
  category "Policy Settings"
  label "Snowflake Recommendation"
  description "Indicates the Snowflake recommendation to provide. Should generally be left at its default value."
  allowed_values "AUTO_SUSPEND"
  default "AUTO_SUSPEND"
end

###############################################################################
# Datasources & Scripts
###############################################################################

datasource "ds_snowflake_data" do
  request do
    verb "GET"
    host "raw.githubusercontent.com"
    path "/flexera-public/cco_demo/refs/heads/main/custom/snowflake/snowflake_data.json"
  end
end

datasource "ds_snowflake_data_normalized" do
  run_script $js_snowflake_data_normalized, $ds_snowflake_data
end

script "js_snowflake_data_normalized", type:"javascript" do
  parameters "ds_snowflake_data"
  result "result"
  code <<-'EOS'
  result = _.map(ds_snowflake_data, function(entry) {
    // Copy existing keys into new object with some normalization to replace spaces with underscores
    new_entry = {}
    _.each(_.keys(entry), function(key) { new_entry[key.replace(/ /g, "_")] = entry[key] })

    if (entry["details"]) {
      _.each(_.keys(entry["details"]), function(key) { new_entry[key.replace(/ /g, "_")] = entry["details"][key] })
    }

    // Copy some values to new keys to match with what the scraper is going to expect
    new_entry["accountID"] = entry["details"]["Vendor Account Id"]
    new_entry["accountName"] = entry["details"]["Vendor Account Name"]

    new_entry["resourceID"] = entry["resource_id"] ? entry["resource_id"] : entry["resource_name"]
    new_entry["resourceName"] = entry["resource_name"]
    new_entry["recommendationDetails"] = entry["recommendation_details"]
    new_entry["vendor"] = entry["cloud_vendor"]
    new_entry["lookbackPeriod"] = entry["lookback_period"]

    new_entry["resourceType"] = entry["details"]["Warehouse Current Size"]
    new_entry["newResourceType"] = entry["details"]["Warehouse Recommended Size"]
    new_entry["autoSuspend"] = entry["details"]["Current Auto Suspend Secs"]
    new_entry["newAutoSuspend"] = entry["details"]["Recommended Auto Suspend Secs"]

    new_entry["savingsCurrency"] = entry["currency"]
    new_entry["savings"] = entry["estimated_monthly_savings_amount"]

    new_entry["utilizationPercentage"] = entry["details"]["Warehouse Utilisation Pct"]
    new_entry["queryLoadPercentageAverage"] = entry["details"]["Avg Query Load Pct"]
    new_entry["queryLoadPercentageP95"] = entry["details"]["P95 Query Load Pct"]
    new_entry["queryOverloadRatio"] = entry["details"]["Queue Overload Ratio"]
    new_entry["workloadTrendFactor"] = entry["details"]["Workload Trend Factor"]
    new_entry["cachePercentageAverage"] = entry["details"]["Avg Cache Pct"]
    new_entry["totalQueryCount"] = entry["details"]["Total Query Count"]
    new_entry["failedQueryCount"] = entry["details"]["Failed Query Count"]

    // Add additional useful values
    new_entry["service"] = "Snowflake"

    return new_entry
  })
EOS
end

# Filter to just the recommendation type this policy template expects
datasource "ds_snowflake_incident" do
  run_script $js_snowflake_incident, $ds_snowflake_data_normalized, $param_sf_recommendation
end

script "js_snowflake_incident", type:"javascript" do
  parameters "ds_snowflake_data_normalized", "param_sf_recommendation"
  result "result"
  code <<-'EOS'
  result = _.filter(ds_snowflake_data_normalized, function(entry) {
    return entry["recommendation_type"] == param_sf_recommendation
  })
EOS
end

###############################################################################
# Policy
###############################################################################

policy "pol_incident" do
  validate_each $ds_snowflake_incident do
    summary_template "Snowflake {{ with index data 0 }}{{ .recommendation_type }}{{ end }}: {{ len data }} Recommendations Found"
    check eq(0, 1)
    export do
      resource_level true
      field "vendor" do
        label "Cloud Vendor"
      end
      field "accountID" do
        label "Account ID"
      end
      field "accountName" do
        label "Account Name"
      end
      field "resourceID" do
        label "Resource ID"
      end
      field "resourceName" do
        label "Resource Name"
      end
      field "recommendationDetails" do
        label "Recommendation"
      end
      field "region" do
        label "Region"
      end
      field "platform" do
        label "Platform"
      end
      field "status" do
        label "Status"
      end
      field "cost" do
        label "Current Cluster Cost"
      end
      field "savings" do
        label "Estimated Monthly Savings"
      end
      field "savingsCurrency" do
        label "Savings Currency"
      end
      field "utilizationPercentage" do
        label "Compute Utilization %"
      end
      field "queryLoadPercentageAverage" do
        label "Query Load Average %"
      end
      field "queryLoadPercentageP95" do
        label "Query Load p95 %"
      end
      field "queryOverloadRatio" do
        label "Query Overload Ratio"
      end
      field "workloadTrendFactor" do
        label "Workload Trend Factor"
      end
      field "cachePercentageAverage" do
        label "Local Cache Hit Rate Average %"
      end
      field "totalQueryCount" do
        label "Total Query Count"
      end
      field "failedQueryCount" do
        label "Failed Query Count"
      end
      field "resourceType" do
        label "Current Size"
      end
      field "newResourceType" do
        label "Recommended Size"
      end
      field "autoSuspend" do
        label "Current Auto Suspend (Seconds)"
      end
      field "newAutoSuspend" do
        label "Recommended Auto Suspend (Seconds)"
      end
      field "lookbackPeriod" do
        label "Look Back Period (Days)"
      end
      field "service" do
        label "Service"
      end
      field "observations" do
        label "Observations"
      end
      field "id" do
        label "ID"
      end
    end
  end
end
